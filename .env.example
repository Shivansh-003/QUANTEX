# Application Environment
ENVIRONMENT=development

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Connection Configuration (Local Service)
POSTGRES_USER=quantex
POSTGRES_PASSWORD=quantex_password
POSTGRES_DB=quantex
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://quantex:quantex_password@127.0.0.1:5432/quantex

# Redis Connection Configuration (Local Service)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
